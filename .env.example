# Future settings contract; EM-001 does not load this file.
# All values are intentionally blank. Never paste credentials into this template.
# Later configuration must default hosted integrations to disabled.

# Application: planned local environment and redacted logging.
ENTERPRISE_MIND_ENV=
LOG_LEVEL=
ENABLE_HOSTED_SERVICES=

# Local inference: configure localhost and an explicitly selected model later.
OLLAMA_BASE_URL=
QWEN_MODEL=
EMBEDDING_MODEL=
HF_TOKEN=

# Local storage: no databases are started in EM-001.
DATABASE_URL=
REDIS_URL=
QDRANT_URL=
QDRANT_API_KEY=

# Optional hosted integrations: leave disabled and blank unless authorized.
PINECONE_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_TRACING=
MLFLOW_TRACKING_URI=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Future AWS concepts only; prefer workload identity over static keys.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
